  "ingredients": [
    "1 cup raw cashews, soaked",
    "1 cup of water",
    "1-2 chipotle peppers in adobo sauce (depending on how spicy you want it)",
    "Juice from 1/2 lemon or lime (or about 1 to 1 1/2 tablespoons)",
    "1 teaspoon smoked paprika",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt"
  ],
  "instructions": [
    "Add all ingredients to a high speed blender and process until smooth and creamy."
