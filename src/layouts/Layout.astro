---
import "../styles/global.css";
import type { Session } from "../lib/session";
import { getUniqueLoginCount } from "../lib/loginCount";

interface Props {
  title: string;
  session?: Session | null;
}
const { title } = Astro.props;
const session = Astro.props.session !== undefined ? Astro.props.session : Astro.locals.session;
const path = Astro.url.pathname;
const loginCount = await getUniqueLoginCount();
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} · Kalorec</title>
  </head>
  <body class="site-body">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-green-900">Skip to content</a>
    <header class="site-header print:hidden">
      <div class="site-header__inner">
        <a href="/" class="site-brand" aria-label="Kalorec home"><img src="/logo.png" alt="" class="site-brand__logo" width="154" height="60" /></a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>{session ? "My recipes" : "Home"}</a>
          {session?.repo && <a href="/shopping-list" aria-current={path === "/shopping-list" ? "page" : undefined}>Shopping list</a>}
          <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
          <a href="/how-to-use" aria-current={path === "/how-to-use" ? "page" : undefined}>How to use</a>
          {session ? (
            <>
              <a href="/settings" aria-current={path === "/settings" ? "page" : undefined}>Settings</a>
              {session.repo && <a href="/recipes/new" class="nav-primary">+ New recipe</a>}
              <form method="POST" action="/api/auth/logout"><button type="submit">Log out</button></form>
            </>
          ) : <a href="/api/auth/login" class="nav-primary">Log in</a>}
        </nav>
        <details class="mobile-menu">
          <summary>Menu</summary>
          <nav class="mobile-menu__panel" aria-label="Mobile">
            <a href="/" aria-current={path === "/" ? "page" : undefined}>{session ? "My recipes" : "Home"}</a>
            {session?.repo && <a href="/shopping-list" aria-current={path === "/shopping-list" ? "page" : undefined}>Shopping list</a>}
            <a href="/about" aria-current={path === "/about" ? "page" : undefined}>About</a>
            <a href="/how-to-use" aria-current={path === "/how-to-use" ? "page" : undefined}>How to use</a>
            {session ? (
              <>
                <a href="/settings" aria-current={path === "/settings" ? "page" : undefined}>Settings · {session.githubLogin}</a>
                {session.repo && <a href="/recipes/new" class="nav-primary">+ New recipe</a>}
                <form method="POST" action="/api/auth/logout"><button type="submit">Log out</button></form>
              </>
            ) : <a href="/api/auth/login" class="nav-primary">Log in</a>}
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <footer class="site-footer print:hidden">
      <div class="site-footer__inner">
        <div class="site-footer__identity">
          <span class="site-footer__brand">Kalorec</span>
          {loginCount !== null && <span class="site-footer__count">{loginCount.toLocaleString()} {loginCount === 1 ? "person has" : "people have"} logged in</span>}
        </div>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="/privacy" aria-current={path === "/privacy" ? "page" : undefined}>Privacy policy</a>
        </nav>
        <small class="site-footer__copyright">© {year} Kalorec</small>
      </div>
    </footer>
  </body>
</html>
