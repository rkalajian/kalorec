---
import type { Recipe } from "../lib/recipe";
import type { CopyAction } from "../lib/copyAction";
import { safeRecipeUrl } from "../lib/normalize";

interface Props {
  recipe: Recipe;
  href?: string;
  copyAction?: CopyAction;
  sourceOwner?: string;
  sourceRepo?: string;
}
const { recipe, href = `/recipes/${recipe.slug}`, copyAction, sourceOwner, sourceRepo } = Astro.props;
const imageUrl = safeRecipeUrl(recipe.image, "image");
---
<article
  class="recipe-card surface-card group overflow-hidden transition duration-200 hover:-translate-y-1 hover:shadow-xl"
  data-tags={recipe.tags.join(",")}
  data-title={recipe.title.toLowerCase()}
>
  <a href={href} class="block h-full text-inherit no-underline focus-visible:outline-offset-[-4px]">
    {imageUrl ? (
      <img src={imageUrl} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
    ) : (
      <div class="grid aspect-[4/3] place-items-center bg-[var(--sage)]" aria-hidden="true">
        <span class="font-serif text-7xl text-[var(--forest)] opacity-60">{recipe.title.charAt(0).toUpperCase()}</span>
      </div>
    )}
    <div class="p-5">
      <p class="eyebrow">Recipe</p>
      <h3 class="mt-2 break-words font-serif text-2xl font-bold leading-tight tracking-tight group-hover:text-[var(--forest)]">{recipe.title}</h3>
      {(recipe.prepTime || recipe.cookTime || recipe.servings) && (
        <p class="muted mt-3 text-sm">{[recipe.prepTime, recipe.cookTime, recipe.servings && `${recipe.servings} servings`].filter(Boolean).join(" · ")}</p>
      )}
    <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
      {recipe.tags.map((tag) => (
        <li class="pill">{tag}</li>
      ))}
    </ul>
    </div>
  </a>
  {copyAction && (
    copyAction.type === "copy" ? (
      <button
        type="button"
        class="copy-recipe-button button-secondary mx-5 mb-5 w-[calc(100%-2.5rem)]"
        data-owner={sourceOwner}
        data-repo={sourceRepo}
        data-slug={recipe.slug}
      >
        Add to my recipes
      </button>
    ) : (
      <a
        href={copyAction.type === "login" ? "/api/auth/login" : "/settings"}
        class="button-secondary mx-5 mb-5 w-[calc(100%-2.5rem)]"
      >
        {copyAction.type === "login" ? "Log in to add" : "Add a repo to save recipes"}
      </a>
    )
  )}
</article>
