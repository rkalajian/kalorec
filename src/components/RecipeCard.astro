---
import type { Recipe } from "../lib/recipe";
import type { CopyAction } from "../lib/copyAction";
import { safeRecipeUrl } from "../lib/normalize";

interface Props {
  recipe: Recipe;
  href?: string;
  copyAction?: CopyAction;
  sourceOwner?: string;
  sourceRepo?: string;
}
const { recipe, href = `/recipes/${recipe.slug}`, copyAction, sourceOwner, sourceRepo } = Astro.props;
const imageUrl = safeRecipeUrl(recipe.image, "image");
---
<div
  class="recipe-card rounded-md border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800"
  data-tags={recipe.tags.join(",")}
  data-title={recipe.title.toLowerCase()}
>
  <a href={href} class="block p-4 text-inherit no-underline">
    {imageUrl && <img src={imageUrl} alt="" loading="lazy" class="mb-3 h-36 w-full rounded-md object-cover" />}
    <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{recipe.title}</h3>
    <ul class="mt-2 flex list-none flex-wrap gap-1.5 p-0">
      {recipe.tags.map((tag) => (
        <li class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700 dark:bg-zinc-700 dark:text-zinc-300">{tag}</li>
      ))}
    </ul>
  </a>
  {copyAction && (
    copyAction.type === "copy" ? (
      <button
        type="button"
        class="copy-recipe-button mx-4 mb-4 block w-[calc(100%-2rem)] rounded-md border border-green-700 px-3 py-1.5 text-sm font-medium text-green-700 hover:bg-green-50 dark:border-green-600 dark:text-green-400 dark:hover:bg-zinc-700"
        data-owner={sourceOwner}
        data-repo={sourceRepo}
        data-slug={recipe.slug}
      >
        Add to my recipes
      </button>
    ) : (
      <a
        href={copyAction.type === "login" ? "/api/auth/login" : "/settings"}
        class="mx-4 mb-4 block w-[calc(100%-2rem)] rounded-md border border-zinc-300 px-3 py-1.5 text-center text-sm font-medium text-zinc-700 no-underline hover:bg-zinc-50 dark:border-zinc-600 dark:text-zinc-300 dark:hover:bg-zinc-700"
      >
        {copyAction.type === "login" ? "Log in to add" : "Add a repo to save recipes"}
      </a>
    )
  )}
</div>
