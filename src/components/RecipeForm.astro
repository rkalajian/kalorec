---
import type { Recipe } from "../lib/recipe";
import { safeRecipeUrl } from "../lib/normalize";

interface Props {
  mode: "create" | "edit";
  recipe?: Recipe;
  sha?: string;
}

const { mode, recipe, sha } = Astro.props;
const sourceRepoIsPublic = Astro.locals.session.repo?.private === false;
const sharingRepo = Astro.locals.session.sharingRepo;
const initial = {
  title: recipe?.title ?? "",
  sourceUrl: safeRecipeUrl(recipe?.sourceUrl, "sourceUrl") ?? "",
  image: safeRecipeUrl(recipe?.image, "image") ?? "",
  tags: recipe?.tags?.join(", ") ?? "",
  servings: recipe?.servings ?? "",
  prepTime: recipe?.prepTime ?? "",
  cookTime: recipe?.cookTime ?? "",
  ingredients: recipe?.ingredients?.length ? recipe.ingredients : [],
  instructions: recipe?.instructions?.length ? recipe.instructions : [],
  nutrition: recipe?.nutrition ?? {},
  notes: recipe?.notes ?? "",
  public: recipe?.public ?? false,
};
const label = "block text-sm font-bold";
const field = "field mt-2";
---

<form id="recipe-form" data-mode={mode} data-slug={recipe?.slug ?? ""} data-sha={sha ?? ""} class="mt-7 space-y-6">
  <script type="application/json" id="recipe-initial-data" set:html={JSON.stringify(initial).replace(/</g, "\\u003c")} />

  {mode === "create" && (
    <section class="surface-card border-[var(--forest)] p-5 sm:p-7" aria-labelledby="import-heading">
      <p class="eyebrow">Have a link?</p>
      <h2 id="import-heading" class="section-title mt-2">Start with an import</h2>
      <p class="muted mt-2 text-sm">Paste a recipe URL, then review what we find before saving.</p>
      <label for="import-url" class={`${label} mt-5`}>Recipe URL</label>
      <div class="mt-2 flex flex-col gap-2 sm:flex-row">
        <input type="url" id="import-url" maxlength="2048" placeholder="https://example.com/recipe" class="field min-w-0 flex-1" />
        <button type="button" id="import-button" class="button-secondary">Import recipe</button>
      </div>
      <p id="import-message" class="message mt-2 min-h-5 text-sm" role="status"></p>
    </section>
  )}

  <p id="form-message" class="message min-h-5 text-sm" role="alert"></p>

  <section class="surface-card p-5 sm:p-7" aria-labelledby="basics-heading">
    <p class="eyebrow">01 / The basics</p>
    <h2 id="basics-heading" class="section-title mt-2">About this recipe</h2>
    <div class="mt-6 grid gap-5">
      <div><label for="title" class={label}>Recipe name <span aria-hidden="true">*</span></label><input type="text" id="title" required maxlength="200" autocomplete="off" placeholder="e.g. Sunday tomato pasta" class={field} /></div>
      <div><label for="tags" class={label}>Tags</label><input type="text" id="tags" placeholder="Dinner, family favorite" aria-describedby="tags-hint" class={field} /><p id="tags-hint" class="muted mt-1 text-xs">Separate tags with commas.</p></div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div><label for="servings" class={label}>Servings</label><input type="text" id="servings" placeholder="4" class={field} /></div>
        <div><label for="prepTime" class={label}>Prep time</label><input type="text" id="prepTime" placeholder="15 minutes" class={field} /></div>
        <div><label for="cookTime" class={label}>Cook time</label><input type="text" id="cookTime" placeholder="30 minutes" class={field} /></div>
      </div>
    </div>
  </section>

  <div class="grid items-start gap-6 lg:grid-cols-2">
    <section class="surface-card p-5 sm:p-7" aria-labelledby="image-heading">
      <p class="eyebrow">02 / Add a little color</p>
      <h2 id="image-heading" class="section-title mt-2">Recipe image</h2>
      <p class="muted mt-2 text-sm">Choose a photo, or paste an HTTPS image URL.</p>
      <label for="image-upload" class={`${label} mt-5`}>Choose an image file</label>
      <input type="file" id="image-upload" accept="image/png,image/jpeg,image/webp,image/gif" aria-describedby="image-upload-help" class={field} />
      <p id="image-upload-help" class="muted mt-1 text-xs">PNG, JPEG, WebP, or GIF, up to 4 MB. A selected file takes priority over the URL.</p>
      <label for="image" class={`${label} mt-5`}>Or image URL</label>
      <input type="text" id="image" maxlength="2048" placeholder="https://example.com/image.jpg" class={field} />
      <p class="muted mt-1 text-xs">Paste an HTTPS URL to replace the current image.</p>
      <div id="image-preview-wrap" hidden={!initial.image} class="mt-5 overflow-hidden rounded-xl border border-[var(--line)]">
        <img id="image-preview" src={initial.image || undefined} alt="Recipe image preview" class="aspect-[4/3] w-full object-cover" />
      </div>
      <button type="button" id="remove-image" hidden={!initial.image} class="text-link mt-3 text-sm">Remove image</button>
    </section>
    <section class="surface-card p-5 sm:p-7" aria-labelledby="sharing-heading">
      <p class="eyebrow">03 / Decide who sees it</p>
      <h2 id="sharing-heading" class="section-title mt-2">Sharing</h2>
      <label class="mt-5 flex min-h-12 cursor-pointer items-start gap-3 rounded-xl bg-[var(--sage)] p-4 text-sm font-semibold" for="public">
        <input type="checkbox" id="public" disabled={!sharingRepo || sourceRepoIsPublic} class="mt-0.5 size-5 shrink-0 accent-green-800" />
        <span>Publish a copy on my public Kalorec profile</span>
      </label>
      {sharingRepo ? (
        <p class="muted mt-3 text-sm leading-relaxed">Your source recipe stays private. A public copy goes to <code class="break-all">{sharingRepo.owner}/{sharingRepo.name}</code>.</p>
      ) : (
        <p class="muted mt-3 text-sm leading-relaxed">Choose a separate public repo in <a href="/settings" class="text-link">Settings</a> to share recipes.</p>
      )}
      {sourceRepoIsPublic && <p class="mt-3 text-sm text-amber-800 dark:text-amber-300">Your source repo is public. Recipe files and their Git history may already be visible.</p>}
      {sharingRepo && <p class="muted mt-3 text-xs">Unpublishing removes the current copy, but past Git commits can remain visible.</p>}
    </section>
  </div>

  <section class="surface-card p-5 sm:p-7" aria-labelledby="ingredients-heading">
    <p class="eyebrow">04 / Gather</p><h2 id="ingredients-heading" class="section-title mt-2">Ingredients</h2>
    <p class="muted mt-2 text-sm">Add each ingredient on its own line.</p>
    <div id="ingredients-list" class="mt-4"></div>
    <button type="button" id="add-ingredient" class="button-secondary mt-4">+ Add ingredient</button>
  </section>

  <section class="surface-card p-5 sm:p-7" aria-labelledby="instructions-heading">
    <p class="eyebrow">05 / Make</p><h2 id="instructions-heading" class="section-title mt-2">Instructions</h2>
    <p class="muted mt-2 text-sm">One step at a time keeps the recipe easy to follow.</p>
    <div id="instructions-list" class="mt-4"></div>
    <button type="button" id="add-instruction" class="button-secondary mt-4">+ Add step</button>
  </section>

  <details class="surface-card p-5 sm:p-7" open={mode === "edit" && Object.values(initial.nutrition).some(Boolean)}>
    <summary class="cursor-pointer font-serif text-xl font-bold">Nutrition <span class="muted font-sans text-sm font-normal">(optional, per serving)</span></summary>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div><label for="nutrition-calories" class={label}>Calories</label><input id="nutrition-calories" class={field} /></div>
      <div><label for="nutrition-protein" class={label}>Protein</label><input id="nutrition-protein" class={field} /></div>
      <div><label for="nutrition-fat" class={label}>Fat</label><input id="nutrition-fat" class={field} /></div>
      <div><label for="nutrition-carbohydrates" class={label}>Carbs</label><input id="nutrition-carbohydrates" class={field} /></div>
      <div><label for="nutrition-fiber" class={label}>Fiber</label><input id="nutrition-fiber" class={field} /></div>
      <div><label for="nutrition-sugar" class={label}>Sugar</label><input id="nutrition-sugar" class={field} /></div>
      <div><label for="nutrition-sodium" class={label}>Sodium</label><input id="nutrition-sodium" class={field} /></div>
    </div>
  </details>

  <section class="surface-card p-5 sm:p-7" aria-labelledby="notes-heading">
    <h2 id="notes-heading" class="section-title">Notes & source</h2>
    <label for="notes" class={`${label} mt-5`}>Notes</label><textarea id="notes" rows="4" placeholder="What makes this recipe yours?" class={field}></textarea>
    <label for="sourceUrl" class={`${label} mt-5`}>Original recipe URL</label><input type="url" id="sourceUrl" maxlength="2048" placeholder="https://example.com/recipe" class={field} />
  </section>

  <div class="surface-card flex flex-wrap items-center justify-between gap-3 p-4 sm:p-5">
    <p class="muted text-sm">{mode === "create" ? "Ready to add it to your collection?" : "Save your changes to update this recipe."}</p>
    <div class="flex flex-wrap gap-2"><button type="submit" id="save-button" class="button-primary">Save recipe</button>{mode === "edit" && <button type="button" id="delete-button" class="button-secondary border-red-300 text-red-700 hover:bg-red-50 dark:text-red-300 dark:hover:bg-red-950">Delete recipe</button>}</div>
  </div>
</form>

<script src="../scripts/recipe-form.ts"></script>
