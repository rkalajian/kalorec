---
import Layout from "../../layouts/Layout.astro";
import RecipeForm from "../../components/RecipeForm.astro";
---
<Layout title="New Recipe">
  <a href="/" class="text-link text-sm">← My recipes</a>
  <p class="eyebrow mt-6">Add to your collection</p>
  <h1 class="page-title mt-2">New recipe</h1>
  <p class="page-intro mt-3">Start with a link, or write it your way.</p>
  <RecipeForm mode="create" />
</Layout>
