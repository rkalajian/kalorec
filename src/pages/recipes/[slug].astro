---
import Layout from "../../layouts/Layout.astro";
import RecipeDetail from "../../components/RecipeDetail.astro";
import { getStore } from "../../lib/store";
import { SESSION_COOKIE } from "../../lib/session";

const { slug } = Astro.params;
const store = getStore({ accessToken: Astro.locals.session.accessToken, repo: Astro.locals.session.repo! });
let stored;
try {
  stored = slug ? await store.get(slug) : null;
} catch (err: any) {
  if (err.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE, { path: "/" });
    return Astro.redirect("/logged-out?error=session_expired");
  }
  if (err.status === 403) return Astro.redirect("/settings?error=no_access");
  throw err;
}
if (!stored) return new Response("Recipe not found", { status: 404 });
const recipe = stored.recipe;
const sharingFailed = Astro.url.searchParams.get("sharing") === "failed";
---

<Layout title={recipe.title}>
  {sharingFailed && <p role="alert" class="mb-5 rounded-xl border border-amber-500 bg-amber-50 p-4 text-sm text-amber-900 dark:bg-amber-950 dark:text-amber-200">Recipe saved, but sharing failed. <a href={`/recipes/${recipe.slug}/edit`} class="underline">Edit and save again</a> to retry.</p>}
  <RecipeDetail recipe={recipe} backHref="/" backLabel="My recipes">
    <a slot="actions" href={`/recipes/${recipe.slug}/edit`} class="button-primary">Edit recipe</a>
  </RecipeDetail>
</Layout>
