---
import Layout from "../../../layouts/Layout.astro";
import RecipeForm from "../../../components/RecipeForm.astro";
import { getStore } from "../../../lib/store";
import { SESSION_COOKIE } from "../../../lib/session";

const { slug } = Astro.params;
const store = getStore({ accessToken: Astro.locals.session.accessToken, repo: Astro.locals.session.repo! });

let stored;
try {
  stored = slug ? await store.get(slug) : null;
} catch (err: any) {
  if (err.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE, { path: "/" });
    return Astro.redirect("/logged-out?error=session_expired");
  }
  if (err.status === 403) {
    return Astro.redirect("/settings?error=no_access");
  }
  throw err;
}

if (!stored) {
  return Astro.redirect("/");
}
---
<Layout title={`Edit ${stored.recipe.title}`}>
  <a href={`/recipes/${stored.recipe.slug}`} class="text-link text-sm">← Back to recipe</a>
  <p class="eyebrow mt-6">Make it yours</p>
  <h1 class="page-title mt-2">Edit {stored.recipe.title}</h1>
  <p class="page-intro mt-3">Update the details, then save your changes.</p>
  <RecipeForm mode="edit" recipe={stored.recipe} sha={stored.sha} />
</Layout>
