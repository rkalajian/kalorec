---
import Layout from "../../../../layouts/Layout.astro";
import RecipeDetail from "../../../../components/RecipeDetail.astro";
import { getPublicRecipe } from "../../../../lib/publicStore";
import { resolveCopyAction } from "../../../../lib/copyAction";

const { owner, repo, slug } = Astro.params;
if (!owner || !repo || !slug) return new Response("Recipe not found", { status: 404 });
let recipe;
try {
  recipe = await getPublicRecipe(owner, repo, slug);
} catch (err: any) {
  return new Response(`Failed to load recipe: ${err.message}`, { status: 502 });
}
if (!recipe) return new Response("Recipe not found", { status: 404 });
const copyAction = resolveCopyAction(Astro.locals.session);
---

<Layout title={recipe.title} session={Astro.locals.session}>
  <RecipeDetail recipe={recipe} backHref={`/u/${owner}/${repo}`} backLabel={`${owner}'s recipes`}>
    {copyAction.type === "copy" ? (
      <button slot="actions" type="button" class="copy-recipe-button button-primary" data-owner={owner} data-repo={repo} data-slug={recipe.slug}>Add to my recipes</button>
    ) : (
      <a slot="actions" href={copyAction.type === "login" ? "/api/auth/login" : "/settings"} class="button-primary">{copyAction.type === "login" ? "Log in to add" : "Add a repo to save recipes"}</a>
    )}
  </RecipeDetail>
</Layout>

<script src="../../../../scripts/copy-recipe.ts"></script>
