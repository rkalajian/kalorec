---
import Layout from "../../../../layouts/Layout.astro";
import RecipeCard from "../../../../components/RecipeCard.astro";
import { listPublicRecipes } from "../../../../lib/publicStore";
import { resolveCopyAction } from "../../../../lib/copyAction";

const { owner, repo } = Astro.params;

let recipes;
try {
  recipes = await listPublicRecipes(owner!, repo!);
} catch (err: any) {
  return new Response(`Failed to load recipes: ${err.message}`, { status: 502 });
}
recipes.sort((a, b) => a.title.localeCompare(b.title));
const allTags = Array.from(new Set(recipes.flatMap((r) => r.tags))).sort();
// Astro.locals.session is typed as always-present, but middleware leaves it
// null on public paths like this one when no cookie is set.
const copyAction = resolveCopyAction(Astro.locals.session);
---
<Layout title={`${owner}'s recipes`} session={Astro.locals.session}>
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="eyebrow">Shared collection</p>
      <h1 class="page-title mt-2">{owner}'s recipes</h1>
      <p class="page-intro mt-3">Recipes they chose to share with you.</p>
    </div>
    <a href="/" class="button-secondary">Explore Kalorec</a>
  </div>

  <div class="surface-card mt-8 p-4 sm:p-5">
    <label for="search-input" class="block text-sm font-bold">Find a recipe</label>
    <input
      type="search"
      id="search-input"
      placeholder="Search by name or tag"
      class="field mt-2"
    />
    <div id="tag-filters" class="mt-4 flex flex-wrap gap-2" aria-label="Filter by tag">
      {allTags.map((tag) => (
        <button
          type="button"
          aria-pressed="false"
          class="tag-filter pill cursor-pointer border border-transparent hover:border-[var(--forest)] aria-pressed:bg-[#205a38] aria-pressed:text-white"
          data-tag={tag}
        >{tag}</button>
      ))}
    </div>
  </div>

  {recipes.length === 0 ? (
    <p class="surface-card mt-8 p-8 text-center muted">No public recipes yet.</p>
  ) : (
    <>
      <div class="mt-7 flex items-baseline justify-between gap-3"><h2 class="section-title">The collection</h2><p id="recipe-count" class="muted text-sm" role="status" aria-live="polite">{recipes.length} {recipes.length === 1 ? "recipe" : "recipes"}</p></div>
      <p id="no-filter-results" hidden class="surface-card mt-5 p-6 text-center">No recipes match your search. Try another word or tag.</p>
      <div id="recipe-grid" class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {recipes.map((recipe) => (
          <RecipeCard recipe={recipe} href={`/u/${owner}/${repo}/${recipe.slug}`} copyAction={copyAction} sourceOwner={owner} sourceRepo={repo} />
        ))}
      </div>
    </>
  )}
</Layout>

<script src="../../../../scripts/recipe-list.ts"></script>
<script src="../../../../scripts/copy-recipe.ts"></script>
