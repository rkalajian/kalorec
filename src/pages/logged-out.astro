---
import "../styles/global.css";

const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  state_mismatch: "Login request could not be verified. Please try again.",
  token_exchange_failed: "GitHub login failed. Please try again.",
  session_expired: "Your session expired. Please log in again.",
};
const message = error ? errorMessages[error] ?? "Something went wrong. Please try again." : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalorec</title>
  </head>
  <body class="flex min-h-screen items-center justify-center p-4">
    <main class="surface-card w-full max-w-md p-8 text-center sm:p-10">
      <div class="site-brand justify-center"><span class="site-brand__mark" aria-hidden="true">K</span>Kalorec</div>
      <h1 class="section-title mt-6">Welcome back to your kitchen</h1>
      {message && <p class="mt-4 text-red-700 dark:text-red-300" role="alert">{message}</p>}
      <a href="/api/auth/login" class="button-primary mt-6">Log in with GitHub</a>
    </main>
  </body>
</html>
