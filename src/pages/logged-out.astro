---
import "../styles/global.css";

const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  state_mismatch: "Login request could not be verified. Please try again.",
  token_exchange_failed: "GitHub login failed. Please try again.",
  session_expired: "Your session expired. Please log in again.",
};
const message = error ? errorMessages[error] ?? "Something went wrong. Please try again." : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalorec</title>
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-900 dark:bg-zinc-900 dark:text-zinc-100 flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-2xl font-semibold tracking-tight">Kalorec</h1>
      {message && <p class="mt-4 text-red-600 dark:text-red-400">{message}</p>}
      <a href="/api/auth/login" class="mt-6 inline-block rounded-md bg-green-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-green-800 dark:bg-green-700 dark:hover:bg-green-800">Log in with GitHub</a>
    </div>
  </body>
</html>
