---
import { Octokit } from "@octokit/rest";
import Layout from "../layouts/Layout.astro";
import { listSelectableRepos } from "../lib/repos";
import { SESSION_COOKIE } from "../lib/session";

const { session } = Astro.locals;
const octokit = new Octokit({ auth: session.accessToken });
let repos;
try {
  repos = await listSelectableRepos(octokit as any);
} catch (err: any) {
  if (err.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE, { path: "/" });
    return Astro.redirect("/logged-out?error=session_expired");
  }
  throw err;
}
const errorMessages: Record<string, string> = {
  no_access: "You no longer have push access to that repo. Pick a different one below.",
  source_must_be_private: "Choose a private repo for recipe storage.",
  sharing_must_be_public: "Choose a public repo for shared recipes.",
  sharing_must_differ: "Choose a different repo for shared recipes.",
  source_has_shared_recipes: "Unshare recipes before changing your source repo.",
  sharing_repo_has_published_recipes: "Remove published copies before changing either repo.",
  sharing_repo_not_empty: "Choose an empty public sharing repo so existing files are not overwritten.",
  repo_change_check_failed: "Could not verify published recipes. Try again.",
  migration_failed: "Could not copy all shared recipes. Your sharing repo is selected; use Sync below to retry.",
  sharing_config_load_failed: "Could not load this repo's sharing configuration. Try again.",
  sharing_config_invalid: "This repo's saved sharing destination is no longer a separate public repo you can write to.",
  sharing_config_save_failed: "Could not save the sharing configuration. Try again.",
};
const error = errorMessages[Astro.url.searchParams.get("error") ?? ""];
const privateRepos = repos.filter((repo) => repo.private);
const publicRepos = repos.filter((repo) => !repo.private);
const selectedPrivate = privateRepos.find((repo) => repo.owner === session.repo?.owner && repo.name === session.repo?.name);
const selectedPublic = publicRepos.find((repo) => repo.owner === session.sharingRepo?.owner && repo.name === session.sharingRepo?.name);
const privateChoices = privateRepos.filter((repo) => repo !== selectedPrivate);
const publicChoices = publicRepos.filter((repo) => repo !== selectedPublic);
---
<Layout title="Settings">
  <div class="space-y-6 pb-12">
    <header class="max-w-3xl">
      <p class="eyebrow">Your collection</p>
      <h1 class="page-title mt-2">Settings</h1>
      <p class="page-intro mt-3">Choose a private home for your recipes. Add a separate public repo only when you want to share.</p>
    </header>

    {error && <p role="alert" class="rounded-2xl border border-[#d6a494] bg-[#fff1eb] px-4 py-3 text-sm leading-relaxed text-[#813b2d]">{error}</p>}

    <div class="grid items-start gap-5 lg:grid-cols-2">
      <section aria-labelledby="private-repo-heading" class="surface-card p-5 sm:p-7">
        <p class="eyebrow">Storage</p>
        <h2 id="private-repo-heading" class="section-title mt-2">Private recipe repo</h2>
        <p class="muted mt-2 text-sm leading-relaxed">Your recipes and saved shopping list live here.</p>

        {selectedPrivate && (
          <div class="mt-5 rounded-2xl border border-[var(--forest)] bg-[var(--sage)] p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--forest)]">Current repo</p>
            <p class="mt-1 break-all font-semibold">{selectedPrivate.owner}/{selectedPrivate.name}</p>
            <form method="POST" action="/api/settings/repo" class="mt-4">
              <input type="hidden" name="owner" value={selectedPrivate.owner} />
              <input type="hidden" name="name" value={selectedPrivate.name} />
              <button type="submit" class="button-secondary w-full sm:w-auto">Reload recipes</button>
            </form>
          </div>
        )}

        {privateRepos.length === 0 ? (
          <p class="muted mt-5 rounded-2xl bg-[var(--sage)] p-4 text-sm leading-relaxed">No private repos with write access found. Create one on GitHub, then return here.</p>
        ) : privateChoices.length > 0 && (
          <details open={!selectedPrivate || Boolean(error)} class="mt-5 rounded-2xl border border-[var(--line)]">
            <summary class="min-h-11 cursor-pointer px-4 py-3 font-semibold">{selectedPrivate ? "Change private repo" : "Choose a private repo"}</summary>
            <ul class="grid gap-2 border-t border-[var(--line)] p-3">
              {privateChoices.map((repo) => (
                <li class="flex min-w-0 flex-col gap-3 rounded-xl bg-[var(--sage)] p-3 sm:flex-row sm:items-center sm:justify-between">
                  <span class="break-all text-sm font-medium">{repo.owner}/{repo.name}</span>
                  <form method="POST" action="/api/settings/repo" class="shrink-0">
                    <input type="hidden" name="owner" value={repo.owner} />
                    <input type="hidden" name="name" value={repo.name} />
                    <button type="submit" class="button-primary w-full sm:w-auto" aria-label={`Select ${repo.owner}/${repo.name} as private recipe repo`}>Select</button>
                  </form>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>

      <section aria-labelledby="sharing-repo-heading" class="surface-card p-5 sm:p-7">
        <p class="eyebrow">Optional sharing</p>
        <h2 id="sharing-repo-heading" class="section-title mt-2">Public sharing repo</h2>
        <p class="muted mt-2 text-sm leading-relaxed">Only recipes you publish are copied here. Choose a separate, empty public repo.</p>

        {session.repo?.private && selectedPublic && (
          <div class="mt-5 rounded-2xl border border-[var(--forest)] bg-[var(--sage)] p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-[var(--forest)]">Current repo</p>
            <p class="mt-1 break-all font-semibold">{selectedPublic.owner}/{selectedPublic.name}</p>
            <form method="POST" action="/api/settings/sharing-repo" class="mt-4">
              <input type="hidden" name="owner" value={selectedPublic.owner} />
              <input type="hidden" name="name" value={selectedPublic.name} />
              <button type="submit" class="button-secondary w-full sm:w-auto">Sync recipes</button>
            </form>
          </div>
        )}

        {!session.repo?.private ? (
          <p class="muted mt-5 rounded-2xl bg-[var(--sage)] p-4 text-sm leading-relaxed">Choose a private recipe repo first to set up sharing.</p>
        ) : publicRepos.length === 0 ? (
          <p class="muted mt-5 rounded-2xl bg-[var(--sage)] p-4 text-sm leading-relaxed">No public repos with write access found. Create an empty one on GitHub if you want to share recipes.</p>
        ) : publicChoices.length > 0 && (
          <details open={!selectedPublic || Boolean(error)} class="mt-5 rounded-2xl border border-[var(--line)]">
            <summary class="min-h-11 cursor-pointer px-4 py-3 font-semibold">{selectedPublic ? "Change public repo" : "Choose a public repo"}</summary>
            <ul class="grid gap-2 border-t border-[var(--line)] p-3">
              {publicChoices.map((repo) => {
                const isSource = session.repo?.owner === repo.owner && session.repo?.name === repo.name;
                return (
                  <li class="flex min-w-0 flex-col gap-3 rounded-xl bg-[var(--sage)] p-3 sm:flex-row sm:items-center sm:justify-between">
                    <span class="break-all text-sm font-medium">{repo.owner}/{repo.name}</span>
                    <form method="POST" action="/api/settings/sharing-repo" class="shrink-0">
                      <input type="hidden" name="owner" value={repo.owner} />
                      <input type="hidden" name="name" value={repo.name} />
                      <button type="submit" class="button-primary w-full disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto" disabled={isSource} aria-label={isSource ? `${repo.owner}/${repo.name} is your source repo` : `Select ${repo.owner}/${repo.name} as public sharing repo`}>{isSource ? "Source repo" : "Select"}</button>
                    </form>
                  </li>
                );
              })}
            </ul>
          </details>
        )}
        <p class="muted mt-4 text-xs leading-relaxed">Unpublishing removes the current copy. Earlier public copies may remain in Git history.</p>
      </section>
    </div>

    {session.repo && (
      <section aria-labelledby="share-profile-heading" class="surface-card p-5 sm:p-7">
        <h2 id="share-profile-heading" class="section-title">Your profile link</h2>
        <p class="muted mt-2 text-sm leading-relaxed">Share this link to show your published recipes.</p>
        {session.sharingRepo ? (
          <>
            <label for="share-link" class="mt-5 block text-sm font-semibold">Public profile URL</label>
            <div class="mt-2 flex flex-col gap-2 sm:flex-row">
              <input type="text" id="share-link" readonly value={`${Astro.url.origin}/u/${session.sharingRepo.owner}/${session.sharingRepo.name}`} class="field min-h-11 min-w-0 flex-1" />
              <button type="button" id="copy-share-link" class="button-secondary min-h-11" aria-live="polite">Copy link</button>
            </div>
          </>
        ) : <p class="muted mt-4 text-sm">Choose a public sharing repo above to get your profile link.</p>}
      </section>
    )}
  </div>
</Layout>
<script src="../scripts/settings.ts"></script>
