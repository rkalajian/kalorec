---
import { Octokit } from "@octokit/rest";
import Layout from "../layouts/Layout.astro";
import { listSelectableRepos } from "../lib/repos";
import { SESSION_COOKIE } from "../lib/session";

const { session } = Astro.locals;
const octokit = new Octokit({ auth: session.accessToken });
let repos;
try {
  repos = await listSelectableRepos(octokit as any);
} catch (err: any) {
  if (err.status === 401) {
    Astro.cookies.delete(SESSION_COOKIE, { path: "/" });
    return Astro.redirect("/logged-out?error=session_expired");
  }
  throw err;
}
const errorMessages: Record<string, string> = {
  no_access: "You no longer have push access to that repo. Pick a different one below.",
  source_must_be_private: "Choose a private repo for recipe storage.",
  sharing_must_be_public: "Choose a public repo for shared recipes.",
  sharing_must_differ: "Choose a different repo for shared recipes.",
  source_has_shared_recipes: "Unshare recipes before changing your source repo.",
  sharing_repo_has_published_recipes: "Remove published copies before changing either repo.",
  sharing_repo_not_empty: "Choose an empty public sharing repo so existing files are not overwritten.",
  repo_change_check_failed: "Could not verify published recipes. Try again.",
  migration_failed: "Could not copy all shared recipes. Your sharing repo is selected; use Sync below to retry.",
  sharing_config_load_failed: "Could not load this repo's sharing configuration. Try again.",
  sharing_config_invalid: "This repo's saved sharing destination is no longer a separate public repo you can write to.",
  sharing_config_save_failed: "Could not save the sharing configuration. Try again.",
};
const error = errorMessages[Astro.url.searchParams.get("error") ?? ""];
const privateRepos = repos.filter((repo) => repo.private);
const publicRepos = repos.filter((repo) => !repo.private);
---
<Layout title="Settings">
  <div class="space-y-7 pb-12 sm:space-y-9">
    <header>
      <p class="eyebrow">Your space</p>
      <h1 class="page-title mt-2">Settings</h1>
      <p class="page-intro mt-3">Keep your collection private. Choose a separate public repo when you want to share recipes.</p>
    </header>

    {error && <p role="alert" class="rounded-2xl border border-[#d6a494] bg-[#fff1eb] px-4 py-3 text-sm leading-relaxed text-[#813b2d]">{error}</p>}

    <section aria-labelledby="private-repo-heading" class="surface-card p-5 sm:p-7">
      <div class="flex items-start gap-4">
        <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[var(--sage)] font-serif text-xl text-[var(--forest)]">1</span>
        <div>
          <h2 id="private-repo-heading" class="section-title">Private recipe repo</h2>
          <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">Your complete recipe collection stays here.</p>
        </div>
      </div>
      {privateRepos.length === 0 ? (
        <p class="mt-5 rounded-2xl bg-[var(--sage)] p-4 text-sm text-[var(--muted)]">No private repos with write access found. Create one on GitHub, then return here.</p>
      ) : (
        <ul class="mt-5 grid gap-3">
          {privateRepos.map((repo) => {
            const isCurrent = session.repo?.owner === repo.owner && session.repo?.name === repo.name;
            return (
              <li class:list={["flex flex-col gap-3 rounded-2xl border p-4 sm:flex-row sm:items-center sm:justify-between", isCurrent ? "border-[var(--forest)] bg-[var(--sage)]" : "border-[var(--line)] bg-[var(--surface)]"]}>
                <div class="min-w-0">
                  <p class="break-all font-medium text-[var(--ink)]">{repo.owner}/{repo.name}</p>
                  <div class="mt-2 flex flex-wrap gap-2 text-xs font-semibold">
                    <span class="rounded-full bg-[#e9eee7] px-2.5 py-1 text-[#526358]">Private</span>
                    {isCurrent && <span class="rounded-full bg-[#dcebd8] px-2.5 py-1 text-[#27523a]">Selected</span>}
                  </div>
                </div>
                <form method="POST" action="/api/settings/repo" class="shrink-0">
                  <input type="hidden" name="owner" value={repo.owner} />
                  <input type="hidden" name="name" value={repo.name} />
                  <button type="submit" class="button-primary min-h-11 w-full sm:w-auto">{isCurrent ? "Reload recipes" : "Select repo"}</button>
                </form>
              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section aria-labelledby="sharing-repo-heading" class="surface-card p-5 sm:p-7">
      <div class="flex items-start gap-4">
        <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[var(--sage)] font-serif text-xl text-[var(--forest)]">2</span>
        <div>
          <h2 id="sharing-repo-heading" class="section-title">Public sharing repo</h2>
          <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">Only recipes you choose to share are copied here.</p>
        </div>
      </div>
      {publicRepos.length === 0 ? (
        <p class="mt-5 rounded-2xl bg-[var(--sage)] p-4 text-sm text-[var(--muted)]">No public repos with write access found. Create an empty one on GitHub to share recipes.</p>
      ) : (
        <ul class="mt-5 grid gap-3">
          {publicRepos.map((repo) => {
            const isCurrent = session.sharingRepo?.owner === repo.owner && session.sharingRepo?.name === repo.name;
            const isSource = session.repo?.owner === repo.owner && session.repo?.name === repo.name;
            return (
              <li class:list={["flex flex-col gap-3 rounded-2xl border p-4 sm:flex-row sm:items-center sm:justify-between", isCurrent ? "border-[var(--forest)] bg-[var(--sage)]" : "border-[var(--line)] bg-[var(--surface)]"]}>
                <div class="min-w-0">
                  <p class="break-all font-medium text-[var(--ink)]">{repo.owner}/{repo.name}</p>
                  <div class="mt-2 flex flex-wrap gap-2 text-xs font-semibold">
                    <span class="rounded-full bg-[#fff0d9] px-2.5 py-1 text-[#83571a]">Public</span>
                    {isCurrent && <span class="rounded-full bg-[#dcebd8] px-2.5 py-1 text-[#27523a]">Selected</span>}
                  </div>
                </div>
                <form method="POST" action="/api/settings/sharing-repo" class="shrink-0">
                  <input type="hidden" name="owner" value={repo.owner} />
                  <input type="hidden" name="name" value={repo.name} />
                  <button type="submit" class="button-primary min-h-11 w-full disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto" disabled={isSource}>{isCurrent ? "Sync recipes" : isSource ? "Source repo" : "Select repo"}</button>
                </form>
              </li>
            );
          })}
        </ul>
      )}
      <p class="mt-4 text-xs leading-relaxed text-[var(--muted)]">Public copies may remain in GitHub history after you unshare them.</p>
    </section>

    {session.repo && (
      <section aria-labelledby="share-profile-heading" class="surface-card p-5 sm:p-7">
        <div class="flex items-start gap-4">
          <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-[var(--sage)] font-serif text-xl text-[var(--forest)]">3</span>
          <div>
            <h2 id="share-profile-heading" class="section-title">Share your profile</h2>
            <p class="mt-1 text-sm leading-relaxed text-[var(--muted)]">Send this link to show the recipes you have shared.</p>
          </div>
        </div>
        <label for="share-link" class="mt-5 block text-sm font-semibold">Profile link</label>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <input type="text" id="share-link" readonly value={session.sharingRepo ? `${Astro.url.origin}/u/${session.sharingRepo.owner}/${session.sharingRepo.name}` : "Choose a public sharing repo first"} class="field min-h-11 min-w-0 flex-1" />
          <button type="button" id="copy-share-link" class="button-secondary min-h-11 disabled:cursor-not-allowed disabled:opacity-60" disabled={!session.sharingRepo}>Copy link</button>
        </div>
        {!session.sharingRepo && <p class="mt-3 text-sm text-[#83571a] dark:text-amber-300">Choose a public sharing repo to get your link.</p>}
      </section>
    )}
  </div>
</Layout>
<script src="../scripts/settings.ts"></script>
